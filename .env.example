# PostgreSQL (Docker default below)
DATABASE_URL="postgresql://tamyr:tamyr_local_password@localhost:5432/tamyr_pop?schema=public"

# Generate unique values before use outside the local demo.
CODE_HMAC_SECRET="replace-with-at-least-32-random-characters"
SESSION_SECRET="replace-with-at-least-32-random-characters"
OTP_HMAC_SECRET="replace-with-at-least-32-random-characters"

# Initial administrator, created by npm run setup / db:seed.
ADMIN_PHONE="+77000000000"
ADMIN_NAME="Admin TAMYR POP"

# Local-only settings. Never set ALLOW_DEV_OTP in production.
DEMO_MODE="true"
ALLOW_DEV_OTP="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
